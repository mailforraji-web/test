{
  "app": {
    "name": "Mail For Raji Web",
    "version": "1.0.0",
    "environment": "development",
    "port": 3000,
    "debug": true
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "mydatabase",
    "username": "admin",
    "password": "changeme123",
    "dialect": "postgresql",
    "pool": {
      "min": 2,
      "max": 10
    }
  },
  "cache": {
    "provider": "redis",
    "host": "localhost",
    "port": 6379,
    "ttl": 3600
  },
  "security": {
    "corsOrigins": ["http://localhost:3000", "http://localhost:5173"],
    "rateLimitWindowMs": 900000,
    "rateLimitMaxRequests": 100
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "file": "logs/app.log"
  },
  "features": {
    "emailVerification": true,
    "twoFactorAuth": false,
    "socialLogin": false
  }
}
